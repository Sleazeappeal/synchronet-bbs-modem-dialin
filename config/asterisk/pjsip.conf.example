;=============================================================================
; Line 404 -- PETSCII, V.22 1200 (Commodore 64)
;=============================================================================

[404](endpoint-tpl)
context = line-petscii
from_user = 404
outbound_auth = 404-auth
aors = 404-aor

[404-aor](aor-tpl)

[404-auth]
type = auth
auth_type = userpass
username = 404
